ELEVENLABS_API_KEY=your_key_here
# the Ernie conversational agent (ElevenLabs > Agents > Ernie > id). Configure it with scripts/setup_agent.py
ELEVENLABS_AGENT_ID=agent_3801m5q9yj5xfm5tq81ngfjss92w

# 1 = read foldback/session.mock.json instead of Ableton. Use for demos without Live open.
FOLDBACK_MOCK=0

# optional: any OpenAI-compatible chat endpoint makes the personality freer (Grok works)
# LLM_BASE_URL=https://api.x.ai/v1
# LLM_API_KEY=
# LLM_MODEL=grok-4

# colon-separated folders to index for sample discovery
# Optional: the app can set these instead (ask Ernie, or click the samples chip). Folders chosen there win.
# SAMPLE_DIRS=/Users/you/Music/Samples:/Users/you/Splice

# optional
TTS_VOICE_ID=JBFqnCBsd6RMkjVDRZzb
TTS_MODEL=eleven_multilingual_v2
TRACK_LENGTH_MS=15000
MUSIC_MODEL=music_v2_5
# OUT_DIR=./demo/generated   # use the committed pre-generated cache for demos
